APP_NAME=OptiStash
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8400

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5545
DB_DATABASE=optistash
DB_USERNAME=optistash
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production TLS is required before enabling secure cookies.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail for supplier portal invitations. MAIL_MAILER=log delivers nothing: outside local/testing the invitation is refused until a real
# mailer is set. Same provider as the other Opti products (SMTP, Postmark transactional stream: smtp, port 587 STARTTLS, access key
# as username and secret key as password; see OptiNexus docs/OPERATIONAL_EMAIL.md). The password is a secret: keep it out of the repository.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

OPTISTASH_DEPLOYMENT_MODE=standalone
OPTISTASH_STANDALONE_TENANT=demo
OPTISTASH_IDENTITY_MODE=local
# Signing secret for events delivered to a tenant's third-party transport API.
OPTISTASH_OUTBOX_SECRET=
# Calls per minute and user for the tenant API (default 120).
OPTISTASH_API_RATE_LIMIT=120

# OptiNexus adapter (read when OPTISTASH_IDENTITY_MODE=optinexus, and by the OPTIDELI pickup relay). Secrets never go in the repository.
OPTINEXUS_BASE_URL=
OPTINEXUS_APPLICATION_CODE=optistash
OPTINEXUS_SSO_CLIENT_ID=
OPTINEXUS_SSO_CLIENT_SECRET=
OPTINEXUS_SSO_REDIRECT_URI=
# Service account scopes: authorization.check, commercial.read, event.write (pickup requests).
OPTINEXUS_SERVICE_CLIENT_ID=
OPTINEXUS_SERVICE_CLIENT_SECRET=
OPTINEXUS_EVENT_WEBHOOK_SECRET=
OPTISTASH_FRONTEND_URL=
